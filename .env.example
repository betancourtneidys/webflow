# All optional. Without a key the assistant answers from the scenario data (demo mode).
# On Webflow Cloud, add keys as Secret Variables in the environment settings.

# Google Gemini (free tier works): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Anthropic Claude
ANTHROPIC_API_KEY=
# CLOUD_DETECTIVE_MODEL=claude-opus-5

# If both keys are set, Anthropic wins unless you force one: anthropic | gemini
# AI_PROVIDER=gemini
